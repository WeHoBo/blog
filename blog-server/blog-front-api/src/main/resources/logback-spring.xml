<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==========================================================================
  日志配置（控制台 + 文件双输出）
  ==========================================================================

  为什么要有这个文件：此前项目只有控制台输出，而 systemd 又没有把 stdout 落盘，
  结果是「服务一重启，崩溃前的日志全没了」，线上排障等于摸黑。
  现在改为：控制台（给 systemd journal / 前台调试）+ 文件（可回溯）。

  日志目录来源：Spring 配置项 logging.file.path
    * 本地开发：application.yml 里默认 ./logs
    * 生产    ：application-prod.yml 里设为 /opt/blog/logs
  滚动策略：单文件最大 50MB，按天归档并 gzip，保留 30 天。
  环境变量 LOG_LEVEL 可覆盖根日志级别（默认 INFO）。

  注意：文件名必须是 logback-spring.xml（带 -spring 后缀）才能让 Spring Boot
  接管 springProperty 解析；普通单元测试不加载它，因此不影响测试。
  ==========================================================================
-->
<configuration>

    <!-- 从 Spring 环境读取日志目录；缺失时退回 ./logs，保证本地也能跑 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- 控制台：前台运行 / journalctl 可见 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志文件 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/blog-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/blog-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 只收 WARN 及以上的错误日志文件：排障时直接看这个，噪音小 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/blog-api-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/blog-api-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 与 application.yml 的 logging.level 保持一致，压掉 MyBatis 的噪音 -->
    <logger name="com.blog.common.mapper" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="org.mybatis.spring" level="WARN"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
