# /opt/blog/rag/backend/.sync.env —— 只给 rag-sync.sh 读
#
#   cp .sync.env.example .sync.env && vi .sync.env && chmod 600 .sync.env
#
# 为什么单独一个文件：crontab 的命令行会出现在 ps、/proc/*/cmdline 和 shell history 里，
# 密码不能走 --password 参数。脚本只读这一行的值，前后别加引号也能跑（会自动去掉）。
BLOG_DB_PASSWORD=

# 数据库不在本机、或不用 root、或不叫 blog 时，import_blog.py 支持用环境变量覆盖，
# 但本脚本没读它们 —— 需要的话直接改 rag-sync.sh 里那一行的调用，
# 或在 /opt/blog/rag/backend/.env 里写 BLOG_DB_HOST / BLOG_DB_USER / BLOG_DB_NAME。
