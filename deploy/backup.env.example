# 好啵博客 —— 备份脚本配置（复制为 /opt/blog/backup.env，chmod 600）
# 由 cron 通过 `set -a; . /opt/blog/backup.env; set +a` 加载，避免密码出现在命令行里。
# 提示：值建议用单引号包住，防止密码里的 $、#、空格等字符被 shell 解析。

DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_NAME='blog'
DB_USER='root'
DB_PASSWORD=''

UPLOAD_DIR='/opt/blog/uploads'
# RAG 向量数据目录（按实际部署路径调整；不确定就先留空目录，脚本会跳过并记录日志）
RAG_DATA_DIR='/opt/blog/rag/data'

BACKUP_ROOT='/opt/blog/backups'
KEEP_DAYS='7'

# 可选：改用 MySQL 凭据文件（比上面写 DB_PASSWORD 更稳妥）
# MYSQL_DEFAULTS_FILE=/opt/blog/.my.cnf
