[Unit]
Description=好啵博客 Nuxt SSR
After=network.target

[Service]
Type=simple
User=ecs-user
WorkingDirectory=/opt/blog/web/.output
# Nuxt SSR 没有日志框架，用 shell 重定向把输出追加到文件。
# 不用 StandardOutput=append:（需要 systemd>=240，阿里云 Linux 3 是 239 会加载失败）。
# 日志文件需对 ecs-user 可写；deploy.sh 会先创建 /opt/blog/logs。
ExecStart=/bin/sh -c 'exec /usr/bin/node server/index.mjs >> /opt/blog/logs/blog-web.log 2>&1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
