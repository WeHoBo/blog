# ============================================================
# 企业级 RAG 智能文档问答系统 —— 环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env && vi .env
# 注意：.env 含真实密钥，已被 .gitignore 忽略，切勿提交。
# ============================================================

# ---------- DeepSeek 大模型配置（必填） ----------
# 在 https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding 向量服务配置（必填） ----------
# DeepSeek 官方【不提供】embedding 接口，必须指向一个 OpenAI 兼容格式的服务，例如：
#   * SiliconFlow（免费额度，模型 BAAI/bge-large-zh-v1.5）  https://api.siliconflow.cn/v1
#   * one-api / new-api 网关                                  http://127.0.0.1:3000/v1
#   * 本地 Ollama                                             http://127.0.0.1:11434/v1
# 注意：更换 embedding 服务/模型后向量维度可能变化，
#       需删除 backend/data/chroma 目录重新上传文档。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ---------- 服务调用鉴权（生产必填） ----------
# 必须与 Java 后端 application-prod.yml 的 ai.rag-token（或环境变量 RAG_API_TOKEN）完全一致。
# 两侧都配同一个值才真正生效；此处为空时服务会【跳过校验】并打印启动警告，
# 等于 RAG 接口没有任何鉴权 —— 仅适合本机开发。
# 生成方式：openssl rand -hex 32
RAG_API_TOKEN=

# ---------- RAG 参数（可选） ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ---------- 数据目录（可选，默认 backend/data） ----------
# RAG_DATA_DIR=/opt/blog/rag/data

# ---------- 直连博客库（可选，部分统计功能用） ----------
# BLOG_DB_HOST=127.0.0.1
# BLOG_DB_NAME=blog
# BLOG_DB_USER=root
# BLOG_DB_PASSWORD=

# ---------- Agent 循环参数（P0/P1，见设计文档 §6.2） ----------
# 工具开关。设 0 可一键退回"纯 RAG 检索问答"的老行为（仍走 SSE），线上排障用。
AGENT_TOOLS_ENABLED=1
# 决策/执行的最大轮次。再多收益递减，成本线性上涨。
AGENT_MAX_STEPS=5
# 整轮时间预算（毫秒），必须 < Java 的 300s < Nginx 的 300s。
AGENT_TOTAL_MS=240000
# 单次工具调用超时（秒）。
AGENT_TOOL_TIMEOUT=10
# 决策段温度：固定偏低，选工具不该有随机性。输出段温度用的是后台每个模型自己的配置。
AGENT_TEMPERATURE_DECIDE=0.2

# ---------- 联网搜索（P3，见设计文档 §9） ----------
# ⚠️ 不填 WEB_SEARCH_API_KEY 时，web_search 工具**不会下发**给模型
#    （不是"挂上但一直失败"）。这是有意的：一个必然失败的工具只会浪费决策 token。
WEB_SEARCH_ENABLED=1
# provider 顺序即降级链。目前支持：tavily、bocha（博查）。
# ⚠️ 国内服务器访问 Tavily 可能不通，上线前先在服务器上测：
#    curl -s -o /dev/null -w "%{http_code}\n" --max-time 10 -X POST \
#      https://api.tavily.com/search -H "Content-Type: application/json" -d '{}'
#    401 = 通（只是没 key）；000 = 不通，改成 bocha。
WEB_SEARCH_PROVIDERS=tavily,bocha
WEB_SEARCH_API_KEY=
# 多 provider 各用不同 key 时配这两个，优先于上面那个全局 key
# WEB_SEARCH_API_KEY_TAVILY=
# WEB_SEARCH_API_KEY_BOCHA=
# 单个 provider 超时（秒）。搜索是锦上添花，3 秒没回就换下一个，别拖慢回答。
WEB_SEARCH_TIMEOUT=3
# 结果缓存（秒）。同一个问题被反复问不必重复付费。
WEB_SEARCH_CACHE_SECONDS=1800
# 单轮最多调几次联网搜索。
WEB_SEARCH_MAX_CALLS=2
# 换厂商 / 走自建代理时覆盖端点；多 provider 请用带后缀的那个
# WEB_SEARCH_BASE_URL=
# WEB_SEARCH_BASE_URL_TAVILY=
# WEB_SEARCH_BASE_URL_BOCHA=
