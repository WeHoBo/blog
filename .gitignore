# Uploads
uploads/

# 部署目录：deploy/ 本身要纳入版本库
# （deploy.sh / nginx.conf / *.service 是"部署真相"，只存在单机磁盘上会失传）。
# 仅忽略其中含真实密钥、本机数据或运行时产物的内容。
deploy/.env
deploy/*.env
deploy/application-prod.yml
deploy/*.bak-*
deploy/mysql-data/
deploy/redis-data/
deploy/logs/
deploy/__pycache__/
*.real
*.yml.real
application-local.yml
application-local.yaml

# Build artifacts
output.tar.gz
output.zip
rag-deploy.tar.gz
tree.txt
test-out.txt
*.dump

# 鸿蒙 App 的 Markdown 渲染器打包脚本（依赖 blog-web/node_modules 的临时工具，
# 产物已落在 HarmonyOS 工程 rawfile/markdown/renderer.js，脚本本身不入库）
blog-web/.renderer-entry.js
blog-web/.build-renderer.mjs
blog-web/web-output.tar.gz
# 前端构建产物的临时打包（8MB+，只用于 scp 上传，不入库）
blog-web/web.tar.gz
blog-web/web-*.tar.gz

# 本地部署中转包（打给服务器手动执行用的 tgz / jar / 源码副本，不入库）
# 否则一次 `git add -A` 会把 70M+ 的二进制推进仓库。
_deploy/

# Python 缓存（rag_system 各子目录都会生成，之前只忽略了 deploy/ 下的）
__pycache__/
*.py[cod]

# 仓库根目录的临时截图（调试时粘贴保存的，不属于项目资源）
/*.png
/*.jpg
/*.jpeg
